# Скопіюйте цей файл у .env і заповніть (файл .env нікому не показуйте!)
# Приватний ключ ТЕСТОВОГО гаманця (з 0x), не основного
PRIVATE_KEY=0x...
# RPC Sepolia (наприклад, Infura: https://sepolia.infura.io/v3/ВАШ_КЛЮЧ); можна лишити порожнім
SEPOLIA_RPC_URL=
# RPC Arbitrum Sepolia; можна лишити порожнім (використається публічний)
ARB_SEPOLIA_RPC_URL=
